{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Bot",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "preLaunchTask": "Setup Local"
    },
    {
      "name": "Run Admin Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests/test_admin_handlers.py"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "preLaunchTask": "Setup Local"
    },
    {
      "name": "Run All Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "tests"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": false,
      "preLaunchTask": "Setup Local"
    }
  ]
}
