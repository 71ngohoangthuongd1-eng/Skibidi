# .env.example
# SECURITY WARNING: Never commit real credentials to version control!
# Deploy checklist:
# 1. Copy this file to .env
# 2. Fill required fields first: TOKEN, OWNER_ID, SECRET_KEY, ADMIN_USERNAME, ADMIN_PASSWORD
# 3. Choose database mode: DATABASE_URL or POSTGRES_*
# 4. Fill SePay fields if you want automatic transfer confirmation

# === TELEGRAM CONFIGURATION ===
# Required
TOKEN=your_bot_token_here
OWNER_ID=123456789

# === PAYMENT CONFIGURATION ===
# Optional payment providers
TELEGRAM_PROVIDER_TOKEN=

# CryptoPay API token (optional)
# Get from: https://t.me/send
CRYPTO_PAY_TOKEN=

# Telegram Stars configuration
# Price of 1 unit of your currency in stars (0 to disable)
STARS_PER_VALUE=0.91

# Currency for payments (3-letter code: RUB, USD, EUR, VND, etc.)
PAY_CURRENCY=VND

# Referral system percentage (0-100, 0 to disable)
REFERRAL_PERCENT=0

# Payment timeout in seconds
PAYMENT_TIME=300

# Payment limits
MIN_AMOUNT=1000
MAX_AMOUNT=10000000

# SePay / bank transfer
# Required for automatic confirmation by IPN
SEPAY_RATE=26000
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_SECRET=
SEPAY_IPN_PATH=/sepay/ipn
SEPAY_PAYMENT_PREFIX=SP

# === LINKS & UI CONFIGURATION ===
# Telegram channel for notifications (optional)
# Format: @channelname or https://t.me/channelname
CHANNEL_URL=

# Telegram channel ID
# Get from: @get_id_bot
CHANNEL_ID=

# Support user ID (optional)
HELPER_ID=

# Bot rules text (optional)
RULES="1. Be respectful\n2. No spam\n3. Follow Telegram ToS"

# === LOCALIZATION & LOGGING ===
# Bot language (en, vi, or ru)
BOT_LOCALE=en

# Log files paths
BOT_LOGFILE=logs/bot.log
BOT_AUDITFILE=logs/audit.log

# Logging configuration (1 to enable, 0 to disable)
LOG_TO_STDOUT=1
LOG_TO_FILE=1
DEBUG=0

# Enable/disable the review system (1 = enabled, 0 = disabled)
REVIEWS_ENABLED=1

# === REDIS CONFIGURATION ===
# Set to 0 to disable Redis entirely (bot will use in-memory storage)
# When disabled, FSM states are lost on restart and caching is disabled
REDIS_ENABLED=1
# Full redis:// URL takes priority over the individual fields below.
# Required for Vercel/Upstash: e.g. rediss://default:TOKEN@host:6379
REDIS_URL=
# For FSM storage and caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Set password if Redis requires authentication
REDIS_PASSWORD=

# === DATABASE CONFIGURATION ===
# Optional full SQLAlchemy URL override.
# Useful for lightweight local testing without PostgreSQL, for example:
# DATABASE_URL=sqlite+aiosqlite:///./data/telegram_shop.db
# Leave empty to use POSTGRES_* settings below.
DATABASE_URL=
# PostgreSQL settings
POSTGRES_DB=telegram_shop
POSTGRES_USER=shop_user
# SECURITY: Use strong password!
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_strong_password
# POSTGRES_HOST is automatically set to 'db' in Docker environment
POSTGRES_HOST=localhost
DB_PORT=5432
# Connection pool tuning (serverless instances share the same Postgres, keep pools small)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=1800

# === WEB ADMIN PANEL ===
ADMIN_HOST=localhost
ADMIN_PORT=9090
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# SECURITY: Change in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# === WEBHOOK MODE (optional) ===
# Set WEBHOOK_ENABLED=1 to use webhook instead of polling
WEBHOOK_ENABLED=0
# Public URL for webhook (e.g., https://yourdomain.com)
WEBHOOK_URL=
# Path for webhook endpoint
WEBHOOK_PATH=/webhook
# Secret token for webhook verification
WEBHOOK_SECRET=

# === VERCEL SERVERLESS (required when deploying to Vercel) ===
# Vercel sets VERCEL=1 automatically in its environment. Do not set it locally.
# Runtime mode: set BOT_MODE=webhook to force webhook behavior (also guards polling).
# BOT_MODE=webhook
# Shared secret used by Vercel Cron to authenticate /api/cron/* requests.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=

# === AUTO-CLEANUP ===
# Days to keep audit log entries (0 to disable)
AUDIT_RETENTION_DAYS=90
# Days to keep pending/failed payments (0 to disable)
PAYMENTS_RETENTION_DAYS=90

# === DOCKER PERMISSIONS (Linux only) ===
# Set these to match your host user's UID/GID on Linux
# Run 'id' command on your host to find your UID/GID
# Default: 1000 (common for first non-root user on Linux)
# Only needed if you get permission errors on logs/ or data/ directories
# PUID=1000
# PGID=1000
