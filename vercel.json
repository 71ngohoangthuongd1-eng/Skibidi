{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "excludeFiles": "{data/**,logs/**,assets/**,.git/**,__pycache__/**,**/__pycache__/**,migrations/**,scripts/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/product-ad",
      "schedule": "0 8 * * *"
    }
  ]
}